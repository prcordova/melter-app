{
  "name": "melter-app",
  "version": "1.0.16",
  "description": "Aplicativo oficial Melter - Conecte-se e compartilhe momentos",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --offline",
    "start:clear": "expo start --offline --clear",
    "start:online": "expo start",
    "android": "expo start --offline --android",
    "ios": "expo start --offline --ios",
    "web": "expo start --offline --web",
    "build": "eas build -p android --profile production",
    "build:preview": "eas build -p android --profile preview",
    "build:apk": "npx eas-cli build -p android --profile apk",
    "build:cancel": "npx eas-cli build:cancel",
    "submit:prod": "eas submit -p android --profile production --latest"
  },
