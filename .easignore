# EAS Build ignore file
# Arquivos que não devem ser enviados para o build

# Dependências (serão instaladas no servidor)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Lock files - EAS usa yarn, então ignoramos package-lock.json
package-lock.json

# Pastas nativas locais (geradas por prebuild) — EAS deve usar app.json, não cópias antigas
android/
ios/

# Build outputs
.expo/
dist/
build/
*.apk
*.aab
*.ipa

# Arquivos de desenvolvimento
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
logs/
*.log

# Arquivos temporários
.tmp/
temp/
*.tmp

# Arquivos do sistema
.DS_Store
Thumbs.db

# Arquivos de documentação (opcional, mas reduz tamanho)
*.md
!README.md

# Arquivos de configuração local
.env.local
.env.*.local
.env
.env.production
.env.preview
.env.development
.env.test
.env.staging
.env.local
.env.development.local
.env.test.local
.env.staging.local
.env.production.local
